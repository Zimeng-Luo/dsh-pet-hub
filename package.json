{
  "name": "dsh-pet-hub",
  "version": "0.1.0",
  "description": "DSH sidebar pet host with BongoCat-compatible runtime",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": "0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "preview": "node scripts/preview.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "easy-live2d": "0.4.4",
    "esbuild": "0.25.12",
    "fflate": "0.8.2",
    "json5": "2.2.3",
    "pixi.js": "8.18.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
